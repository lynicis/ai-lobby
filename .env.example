# Required: at least one of these for the panel. Missing keys are skipped silently.
GEMINI_API_KEY=
GROK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Model IDs follow the Vercel AI SDK convention: <provider>:<model>
# Override only if you want a different model.

SUPERVISOR_MODEL=anthropic:claude-opus-4-5
GEMINI_MODEL=google:gemini-2.5-pro
GROK_MODEL=openai-compatible:grok-4-latest
OPENAI_MODEL=openai:gpt-4o
CLAUDE_PANEL_MODEL=anthropic:claude-sonnet-4-5

# Override default per-call timeout (ms)
DEFAULT_TIMEOUT_MS=60000

# ── LLM gateway support ──────────────────────────────────────────────────────
# Option A: generic gateway slot (OpenAI-compatible endpoint).
# Both GATEWAY_API_KEY and GATEWAY_BASE_URL must be set for the slot to run.
# Examples: https://openrouter.ai/api/v1, https://your-litellm.example/v1
GATEWAY_API_KEY=
GATEWAY_BASE_URL=
GATEWAY_MODEL=gateway:gpt-4o
# Optional: OpenRouter-style attribution headers. Skip if your gateway doesn't need them.
GATEWAY_APP_URL=
GATEWAY_APP_TITLE=ai-lobby

# Option B: route any individual first-party provider through a compatible gateway.
# Leave empty to use the provider's default endpoint.
ANTHROPIC_BASE_URL=
OPENAI_BASE_URL=
GOOGLE_BASE_URL=
XAI_BASE_URL=
