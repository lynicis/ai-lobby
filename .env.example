# Required: at least one of these for the panel. Missing keys are skipped silently.
GEMINI_API_KEY=
GROK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Model IDs follow the Vercel AI SDK convention: <provider>:<model>
# Override only if you want a different model.

SUPERVISOR_MODEL=anthropic:claude-opus-4-5
GEMINI_MODEL=google:gemini-2.5-pro
GROK_MODEL=openai-compatible:grok-4-latest
OPENAI_MODEL=openai:gpt-4o
CLAUDE_PANEL_MODEL=anthropic:claude-sonnet-4-5

# Override default per-call timeout (ms)
DEFAULT_TIMEOUT_MS=60000